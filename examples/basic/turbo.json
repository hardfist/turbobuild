{
  // A tiny project used to try out turbobuild:
  //   cargo tb -C examples/basic fingerprint
  //   cargo tb -C examples/basic fingerprint --watch
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "inputs": ["src/**", "schema/**"],
      "outputs": ["dist/**"]
    },
    "codegen": {
      "inputs": ["schema/*.graphql"]
    },
    "lint": {}
  }
}
